// =====================================================================
// ЗАДАНИЕ 1. Создание двоичного файла записей.
// Вариант 10: "Страхование автосредства"
//   ключ = регистрационный номер (6-значное число, уникальный)
//   поле = название страховой компании
// =====================================================================

#include <iostream>
#include <fstream>
#include <vector>
#include <algorithm>
#include <random>
#include <string>
#include <cstring>

using namespace std;

// ---------------------------------------------------------------------
// СТРУКТУРА ОДНОЙ ЗАПИСИ ФАЙЛА
// ---------------------------------------------------------------------
struct Record {
    int  reg_number;      // ключ: регистрационный номер (6-значное число)
    char company[40];     // название страховой компании (фикс. длина!)
};

const size_t REC_SIZE = sizeof(Record);   // размер одной записи в байтах

// Список компаний, из которых будем случайно выбирать при генерации
static const char* COMPANIES[] = {
    "Rosgosstrakh", "Ingosstrakh", "SOGAZ", "AlfaStrakhovanie",
    "RESO-Garantiya", "VSK", "Soglasie", "Tinkoff Strakhovanie",
    "Sberbank Strakhovanie", "Renaissance Strakhovanie"
};
const int COMPANIES_COUNT = sizeof(COMPANIES) / sizeof(COMPANIES[0]);

// ---------------------------------------------------------------------
// ШАГ 1: генерация ТЕКСТОВОГО файла со случайными уникальными ключами
// ---------------------------------------------------------------------
void generateTextFile(const string& filename, int count) {
    // берём ВЕСЬ диапазон 6-значных чисел: 100000..999999
    vector<int> pool;
    pool.reserve(900000);
    for (int v = 100000; v <= 999999; ++v) pool.push_back(v);

    // перемешиваем этот диапазон как колоду карт
    mt19937 rng(random_device{}());
    shuffle(pool.begin(), pool.end(), rng);

    // берём первые count чисел из перемешанной колоды -> они гарантированно разные
    uniform_int_distribution<int> compDist(0, COMPANIES_COUNT - 1);

    ofstream out(filename);
    for (int i = 0; i < count; ++i) {
        out << pool[i] << ';' << COMPANIES[compDist(rng)] << '\n';
    }
}

// ---------------------------------------------------------------------
// ШАГ 2: преобразование текстового файла в ДВОИЧНЫЙ
// ---------------------------------------------------------------------
void textToBinary(const string& textFile, const string& binFile) {
    ifstream in(textFile);
    ofstream out(binFile, ios::binary);   // важно: открываем в двоичном режиме

    string line;
    while (getline(in, line)) {
        if (line.empty()) continue;

        size_t pos = line.find(';');
        Record r{};                                    // обнулили запись
        r.reg_number = stoi(line.substr(0, pos));       // число до ';'
        string comp = line.substr(pos + 1);             // текст после ';'
        strncpy(r.company, comp.c_str(), sizeof(r.company) - 1);
        r.company[sizeof(r.company) - 1] = '\0';

        // пишем запись как есть, в сыром двоичном виде, ровно REC_SIZE байт
        out.write(reinterpret_cast<char*>(&r), REC_SIZE);
    }
}

// ---------------------------------------------------------------------
// MAIN: запуск -> ./task1 100   (создаст файл из 100 записей)
// ---------------------------------------------------------------------
int main(int argc, char* argv[]) {
    int N = (argc >= 2) ? stoi(argv[1]) : 100;

    string textFile = "data_" + to_string(N) + ".txt";
    string binFile  = "data_" + to_string(N) + ".bin";

    cout << "Размер одной записи (sizeof(Record)) = " << REC_SIZE << " байт\n";

    generateTextFile(textFile, N);
    cout << "Текстовый файл создан: " << textFile << "\n";

    textToBinary(textFile, binFile);
    cout << "Двоичный файл создан: " << binFile << "\n";
    cout << "Итоговый размер файла = " << N << " x " << REC_SIZE
         << " = " << (long)N * REC_SIZE << " байт\n";

    return 0;
}